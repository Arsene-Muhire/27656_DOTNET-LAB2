<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Tells Visual Studio these files are Windows Forms, so double-clicking them opens the designer -->
  <ItemGroup>
    <Compile Update="LoginForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ChooseForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="BicycleForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MushroomForm.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>
